{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PISTE Studio",
  "version": "0.25.0",
  "identifier": "fr.piste.studio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "PISTE Studio",
        "width": 860,
        "height": 560,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/piste-studio-backend"
    ],
    "shortDescription": "Montage local avec canon, locks, versions et delivery",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  }
}
